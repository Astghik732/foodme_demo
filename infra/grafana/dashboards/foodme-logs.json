{
  "id": null,
  "uid": "foodme-logs",
  "title": "FoodMe Logs",
  "tags": ["foodme"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "level",
        "type": "custom",
        "label": "Level",
        "query": "ALL : .*, DEBUG, INFO, WARN, ERROR",
        "current": { "text": "ALL", "value": ".*" },
        "options": [
          { "text": "ALL", "value": ".*", "selected": true },
          { "text": "DEBUG", "value": "DEBUG", "selected": false },
          { "text": "INFO", "value": "INFO", "selected": false },
          { "text": "WARN", "value": "WARN", "selected": false },
          { "text": "ERROR", "value": "ERROR", "selected": false }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Container logs",
      "type": "logs",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{container=~\".+\"} |~ `$level`",
          "refId": "A"
        }
      ]
    }
  ]
}
