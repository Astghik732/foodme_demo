# __PORT__ is replaced with Render's $PORT by entrypoint.sh.
# This file REPLACES /etc/nginx/nginx.conf, so it carries the top-level blocks.
worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log off;
    # Long reads: a cold free instance and big LogQL/PromQL scans are slow.
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    server {
        listen __PORT__;

        # Prometheus runs with --web.route-prefix=/prom, so pass the prefix
        # through unchanged (no trailing slash on proxy_pass) and its UI assets
        # and API both resolve correctly.
        location /prom/ {
            proxy_pass http://127.0.0.1:9090;
        }

        # Loki's own API paths already start with /loki/, so this is a
        # straight passthrough — including /loki/api/v1/push used by the app.
        location /loki/ {
            proxy_pass http://127.0.0.1:3100;
        }

        # MCP uses streamable-http; buffering would stall the stream.
        location /mcp {
            proxy_pass http://127.0.0.1:8000;
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;
        }

        # Grafana last: it owns the root, including /api/health (Render's
        # health check) and the websocket-based live features.
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
